{
  "name": "neko-status-desktop",
  "version": "1.5.0-beta.3",
  "description": "Neko Status Desktop Client — Windows 状态监控工具",
  "main": "src/main/main.js",
  "author": "NF Team",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/start-electron.js",
    "dev:startup-update:checking": "node scripts/start-electron.js --dev-startup-update=checking",
    "dev:startup-update:available": "node scripts/start-electron.js --dev-startup-update=available",
    "dev:startup-update:download": "node scripts/start-electron.js --dev-startup-update=download",
    "dev:startup-update:installing": "node scripts/start-electron.js --dev-startup-update=installing",
    "dev:startup-update:failed": "node scripts/start-electron.js --dev-startup-update=failed",
    "dev:startup-update:offline": "node scripts/start-electron.js --dev-startup-update=offline",
    "dev:startup-update:up-to-date": "node scripts/start-electron.js --dev-startup-update=up-to-date",
    "start": "node scripts/start-electron.js",
    "build:agent": "node scripts/build-presence-agent.js",
    "test:agent": "cargo test --manifest-path native/presence-agent/Cargo.toml --locked",
    "validate:agent": "node scripts/validate-presence-agent.js",
    "build": "npm run build:agent && electron-builder --win --x64",
    "build:nsis": "npm run build:agent && electron-builder --win nsis --x64",
    "build:zip": "npm run build:agent && electron-builder --win zip --x64",
    "release:gitea": "node scripts/publish-gitea-release.js",
    "release:gitea:local": "node scripts/publish-gitea-release.js --token-file .secrets/gitea-token.txt",
    "release:gitea:dry-run": "node scripts/publish-gitea-release.js --dry-run",
    "repo:sync": "node scripts/sync-git-mirror.js",
    "repo:sync:dry-run": "node scripts/sync-git-mirror.js --dry-run",
    "lint": "node scripts/verify.js && node scripts/verify-diagnostics-contract.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:smoke": "node --test \"tests/smoke/*.test.js\"",
    "test:visual": "node tests/visual/run-visual-tests.js",
    "test:visual:update": "node tests/visual/run-visual-tests.js --update",
    "test:watch": "node --test --watch \"tests/unit/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/*.test.js\"",
    "verify": "npm run lint && npm run test"
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "build": {
    "appId": "com.koirin.neko-status",
    "productName": "NekoStatus",
    "copyright": "Copyright © 2026 NF Team",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/@phosphor-icons/web/src/regular/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/app_icon.ico",
        "to": "app_icon.ico"
      },
      {
        "from": "assets/app_icon.png",
        "to": "app_icon.png"
      },
      {
        "from": "build/native/NekoPresenceAgent.exe",
        "to": "NekoPresenceAgent.exe"
      }
    ],
    "win": {
      "executableName": "NekoStatus",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app_icon.ico",
      "artifactName": "NekoStatus-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app_icon.ico",
      "uninstallerIcon": "assets/app_icon.ico",
      "installerHeaderIcon": "assets/app_icon.ico",
      "shortcutName": "NekoStatus",
      "artifactName": "NekoStatus-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "publish": null
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "chart.js": "^4.5.1",
    "obs-websocket-js": "^5.0.8"
  }
}
